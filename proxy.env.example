# Microsoft 365 Copilot Proxy Configuration Template
# Copy to ~/.config/m365-copilot-proxy/proxy.env or use with local environment

# Security and Networking
HOST=127.0.0.1
PORT=4141
NITRO_HOST=127.0.0.1
NITRO_PORT=4141
M365_REQUIRE_API_KEY=1
M365_PROXY_API_KEY=your-random-generated-bearer-token

# Default Model Selection (Truthful M365 models)
# Options: gpt-5.5-think-deeper, gpt-5.6, claude-opus, claude-sonnet
M365_DEFAULT_MODEL=gpt-5.5-think-deeper

# Dynamic Custom Model Aliases & Enterprise Policy Spoofing:
# If your organization or Claude Code enforces specific Anthropic model names,
# you can define custom aliases either via JSON string or by pointing to a config file:
#
# Option A: In-line environment variable (JSON or key=value pairs)
# M365_MODEL_ALIASES={"claude-opus-4.6":"gpt-5.5-think-deeper","eu.anthropic.claude-opus-4.6":"gpt-5.5-think-deeper"}
#
# Option B: Path to a dedicated JSON file (default looked up at ~/.config/m365-copilot-proxy/model-aliases.json)
# M365_MODEL_ALIASES_FILE=~/.config/m365-copilot-proxy/model-aliases.json

# Grounding and Memory Behavior
# Default is agent=web (web grounding on, work/corporate documents grounding off)
M365_AGENT=web
M365_DISABLE_MEMORY=1

# Tool Execution Format (fenced is optimal for coding benchmarks)
M365_TOOL_FORMAT=fenced

# Optional: Direct Corporate Access Token override (bypasses browser login)
# M365_ACCESS_TOKEN=eyJ0eXAi...

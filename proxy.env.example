# Microsoft 365 Copilot Proxy Configuration Template
# Copy to ~/.config/m365-copilot-proxy/proxy.env or use with local environment

# Security and Networking
HOST=127.0.0.1
PORT=4141
NITRO_HOST=127.0.0.1
NITRO_PORT=4141
M365_REQUIRE_API_KEY=1
M365_PROXY_API_KEY=your-random-generated-bearer-token

# Default Model Selection
# Recommended enterprise alias: claude-opus-4.6 (spoofed to M365 GPT-5.5 Reasoning)
# Or: claude-sonnet-4.6, claude-opus-4.8, gpt-5.6, gpt-5.5
M365_DEFAULT_MODEL=claude-opus-4.6

# Allowed Enterprise Policy Models Reference:
# If your organization enforces allowed model names in Claude Code, choose from:
#   - Opus (routed to GPT-5.5 Reasoning): claude-opus-4.6, opus-4.6, eu.anthropic.claude-opus-4.6
#   - Opus (routed to M365 Claude Opus):   claude-opus-4.8, claude-opus-5, eu.anthropic.claude-opus-4-8
#   - Sonnet (routed to M365 Sonnet):      claude-sonnet-4.6, sonnet-4-6, eu.anthropic.claude-sonnet-5
#   - Direct M365 Reasoning:              gpt-5.6, gpt-5.5-think-deeper

# Grounding and Memory Behavior
# Default is agent=web (web grounding on, work/corporate documents grounding off)
M365_AGENT=web
M365_DISABLE_MEMORY=1

# Tool Execution Format (fenced is optimal for coding benchmarks)
M365_TOOL_FORMAT=fenced

# Optional: Direct Corporate Access Token override (bypasses browser login)
# M365_ACCESS_TOKEN=eyJ0eXAi...
